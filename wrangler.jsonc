{
  "name": "hillspringacademy",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],\n  "vars": {\n    "TURNSTILE_HOSTNAMES": "hillspringsacademy.sc.ke"\n  },
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
